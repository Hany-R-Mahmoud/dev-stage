# Used by client-side canonical, Open Graph, and hreflang metadata. Override when a custom domain is active.
VITE_SITE_URL=https://dev2stage.vercel.app

# Public browser key from HeronSignal Dashboard → Install. Leave unset to disable monitoring locally.
VITE_HERONSIGNAL_PUBLIC_KEY=your-heronsignal-public-key

# Used by the sitemap and robots generator. Override when a custom domain is active.
SITE_URL=https://dev2stage.vercel.app

# Optional production visitor counters. Configure an Upstash Redis/Vercel KV store
# in the deployment environment to replace the local development fallback.
KV_REST_API_URL=https://your-upstash-redis-url
KV_REST_API_TOKEN=your-upstash-redis-token
